# =====================================================================
#  Секреты контент-завода. Скопируйте файл в .env и заполните.
#  .env не попадает в git (см. .gitignore).
# =====================================================================

# --- Публикация в Telegram (бесплатный Bot API) -----------------------
# 1) Создайте бота у @BotFather: /newbot
# 2) Добавьте бота администратором в каждый канал (право "Публикация")
TELEGRAM_BOT_TOKEN=

# Релей Bot API (если api.telegram.org блокируется сетью), см. docs/pipedream-relay.md.
# Вариант 1 — Pipedream: https://<workflow>.m.pipedream.net
# Вариант 2 — свой Cloudflare Worker (прокси на api.telegram.org).
TELEGRAM_API_BASE=

# ID каналов: @username или числовой -100... (по одному на канал).
# Если не заполнить — канал работает в dry_run (посты в data/outbox).
TELEGRAM_CHAT_ID_TECH_AI=
TELEGRAM_CHAT_ID_BUSINESS_FINANCE=
TELEGRAM_CHAT_ID_SCIENCE_HEALTH=
TELEGRAM_CHAT_ID_AUTO=
TELEGRAM_CHAT_ID_TRAVEL=
TELEGRAM_CHAT_ID_CULTURE=
# Испаноязычные каналы (config/channels.es.yaml)
TELEGRAM_CHAT_ID_TECH_AI_ES=
TELEGRAM_CHAT_ID_CRYPTO_ES=
TELEGRAM_CHAT_ID_FUTBOL_ES=

# --- Публикация во ВКонтакте (бесплатно, работает в России) ----------
# Токен группы с правами wall, manage. group_id — числовой id группы.
VK_ACCESS_TOKEN=
VK_GROUP_ID=

# --- Язык и список каналов -------------------------------------------
# Язык задаётся у канала в config/channels*.yaml (language: ru|en|es),
# а файл каналов — в app.channels_file (config/settings.yaml).
# Можно переопределить файлом каналов без правки YAML:
# CONTENT_FACTORY_CHANNELS=config/channels.en.yaml
# Испаноязычные каналы (ЛатАм/Испания):
# CONTENT_FACTORY_CHANNELS=config/channels.es.yaml

# --- Режим публикации ------------------------------------------------
# true  — ничего не публиковать, складывать посты в data/outbox (безопасно)
# false — реальная публикация
CONTENT_FACTORY_DRY_RUN=true

# --- Опционально: локальная LLM через Ollama -------------------------
# Установите Ollama (бесплатно, работает офлайн), затем:
#   ollama pull qwen2.5:7b
# В config/settings.yaml укажите llm.provider: ollama
# OLLAMA_HOST при необходимости: http://127.0.0.1:11434
OLLAMA_HOST=

# --- Опционально: GigaChat (Сбер) — есть бесплатный лимит ------------
# credentials — base64(client_id:client_secret) из личного кабинета GigaChat API
GIGACHAT_CREDENTIALS=

# --- Опционально: YandexGPT (пробный грант) --------------------------
YANDEXGPT_API_KEY=
YANDEX_FOLDER_ID=

# --- LLM-провайдеры (бесплатные лимиты) ------------------------------
# Добавляются скриптом: python3 scripts/set_extra_keys.py
# Из РФ: OpenAI (403 unsupported_country), Groq и OpenRouter (403 Cloudflare
# security policy) недоступны — нужен зарубежный egress (VPN, GitHub Actions).
# SambaNova из РФ доступен, но free-аккаунту нужен payment method (402).
# HuggingFace free-аккаунту нужны кредиты инференса (402).
# Ollama Cloud (pay-as-you-go, https://ollama.com/v1): открытые модели работают,
# «pro»-модели требуют Pro/кредиты.
GROQ_API_KEY=
OPENROUTER_API_KEY=
SAMBANOVA_API_KEY=
OLLAMA_API_KEY=
HUGGINGFACE_API_KEY=
OPENAI_API_KEY=
# DeepSeek (OpenAI-совместимый, доступен из РФ) — запасной LLM
DEEPSEEK_API_KEY=

# Cohere (Trial: 1000 запросов/мес, 20/мин; OpenAI-совместимый Compatibility API).
# Из РФ api.cohere.ai отдаёт 403 — провайдер работает из GitHub Actions/VPN.
COHERE_API_KEY=
# Новостные API / поиск (опционально, добавляются тем же скриптом)
# newsdata.io — работает из РФ; GDELT Cloud (gdeltcloud.com) — работает,
# free = 200 стартовых вызовов; Tavily — из РФ 403 (геоблок).
NEWSDATA_API_KEY=
CURRENTS_API_KEY=
APITUBE_API_KEY=
TRENDS_API_KEY=
GDELT_CLOUD_API_KEY=
TAVILY_API_KEY=
TAVILY_API_KEY_2=

# --- Опционально: Dify Cloud — приложение как LLM ---------------------
# 1) https://cloud.dify.ai → создайте приложение (Chat или Text Generator)
# 2) в приложении: API Access → API Key (ключ именно приложения, не workspace)
# 3) config/settings.yaml: llm.provider: dify и llm.dify.app_mode
DIFY_API_KEY=
# Для self-hosted Dify: адрес API, например http://127.0.0.1/v1
DIFY_BASE_URL=

# --- Опционально: отдельные Dify-приложения (workflow) ----------------
# Новости/агрегатор, поиск трендов и SEO-оптимизация постов.
# Готовые посты (Six-Channel...): DIFY_POSTS_API_KEY — основной для публикации.
# Ключи добавляются скриптом: python3 scripts/set_dify_app_keys.py
DIFY_POSTS_API_KEY=
DIFY_NEWS_API_KEY=
DIFY_TRENDS_API_KEY=
DIFY_SEO_API_KEY=

# --- Опционально: World News API (бесплатно 50 points/сутки) ---------
# Ключ: https://worldnewsapi.com/console → API key.
# Добавляется скриптом: python3 scripts/set_worldnews_key.py
WORLD_NEWS_API_KEY=

# --- Опционально: Telegram-каналы как ИСТОЧНИКИ и метрики (Telethon) --
# api_id/api_hash: https://my.telegram.org (бесплатно)
# Нужны для просмотров/реакций/репостов в `telegram-metrics` и отчёте.
TG_API_ID=
TG_API_HASH=
# Имя файла сессии (создастся при первом запуске, храните как пароль)
TG_SESSION=content_factory

# --- Cloudflare Workers AI (OpenAI-совместимый API) -------------------
# Account ID: дашборд Cloudflare → страница аккаунта (правая панель).
# Токен: My Profile → API Tokens → Create Token, права Account → Workers AI → Read.
# Подключён как provider: cloudflare в config/settings.yaml.
# Free-план: ~10 000 neurons/день.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Postman API Key (личный кабинет → Settings → API keys): для CLI `postman`
# и загрузки коллекции API-проверок проекта в ваше рабочее пространство.
POSTMAN_API_KEY=

# --- Бесплатное продвижение: соцсети, growth-бот, IndexNow -------------
# Только живые EN/ES-каналы (US/LatAm); RU-каналы эти ключи не используют.
# Публикаторы Bluesky/Mastodon/Discord опциональны: без ключей просто пропускаются.
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
# Для аккаунта на каждый канал добавьте суффикс id: AI_NEWS, CRYPTO_NEWS,
# SPORT_NEWS, TECH_AI_ES, CRYPTO_ES, FUTBOL_ES (например BLUESKY_HANDLE_AI_NEWS)
MASTODON_BASE_URL=
MASTODON_TOKEN=
DISCORD_WEBHOOK_URL=

# --- Tumblr (OAuth 1.0a): приложение https://www.tumblr.com/oauth/apps ---
# Ключи приложения: oauth/apps → Show secret key (Consumer Key/Secret).
# Токен пользователя получается OAuth 1.0a flow (request_token →
# authorize → access_token). Блог можно переопределить на канал:
# TUMBLR_BLOG_<CHANNEL_ID> (например TUMBLR_BLOG_CRYPTO_ES).
TUMBLR_CONSUMER_KEY=
TUMBLR_CONSUMER_SECRET=
TUMBLR_OAUTH_TOKEN=
TUMBLR_OAUTH_TOKEN_SECRET=
TUMBLR_BLOG=

# --- X (Twitter) API v2: developer.x.com → app Keys and tokens (Write) ---
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# --- Facebook Page: Graph API page token (pages_manage_posts) ---
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=

# --- LinkedIn: OAuth2 token (w_member_social / w_organization_social) ---
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=     # urn:li:organization:123456 или urn:li:person:xxx

# --- Medium: Settings → Security and apps → Integration tokens ---
MEDIUM_TOKEN=

# --- Twelve Data: рыночные данные (бесплатно 800 кредитов/день) ---
# https://twelvedata.com/pricing → API key
TWELVEDATA_API_KEY=

# Growth-бот: deep links ?start= + inline mode (scripts/telegram-growth-bot.py)
# В @BotFather включите inline mode: /setinline и /setcommands.
TELEGRAM_GROWTH_BOT_USERNAME=
# Публичные ссылки каналов (для кнопки «Открыть канал» и лендинга):
# TELEGRAM_CHANNEL_URL_AI_NEWS=https://t.me/AINEWS0007
# TELEGRAM_CHANNEL_URL_CRYPTO_NEWS=https://t.me/HOOPY0007
# TELEGRAM_CHANNEL_URL_SPORT_NEWS=https://t.me/SPORTNews0007
# TELEGRAM_CHANNEL_URL_TECH_AI_ES=https://t.me/WORLDNews0007
# TELEGRAM_CHANNEL_URL_CRYPTO_ES=https://t.me/TechnologiesNews01
# TELEGRAM_CHANNEL_URL_FUTBOL_ES=https://t.me/SPORTSAnalytics007

# IndexNow: бесплатная индексация лендинга в Bing/Yandex (scripts/indexnow_ping.py)
# host — домен GitHub Pages без схемы, например user.github.io
INDEXNOW_KEY=
LANDING_HOST=

# --- GA4: Measurement ID веб-потока (Admin → Data streams) ---
# Подставляется в gtag.js на страницы лендинга (scripts/build_landing.py).
GA4_MEASUREMENT_ID=
GA4_PROPERTY_ID=
# JSON сервисного аккаунта одной строкой (в Actions — secret GA4_SA_JSON);
# локально можно указать путь: GA4_SA_FILE=~/path/google-sa.json
GA4_SA_JSON=

# Leonardo.ai (https://app.leonardo.ai/api-access)
LEONARDO_API_KEY=
# Pollinations: необязательный pollen-ключ (снимает лимит 1/45с)
POLLINATIONS_TOKEN=

# --- OSS Radar (рубрика «свежие open-source релизы», только EN/ES) ----
# GitHub token НЕ обязателен: без него 60 запросов/час, с токеном — 5000/час.
# Нужен только для scripts/oss_radar.py (публикация не автоматическая).
GITHUB_TOKEN=
# Опционально: единый фид PyPI+npm+crates (бесплатный ключ libraries.io через GitHub OAuth)
LIBRARIES_IO_API_KEY=

# --- Монетизация: продажа рекламы за Telegram Stars ------------------
# Бот принимает заказы (scripts/ad_bot.py), модерация — кнопки админу.
# Токен — тот же бот, что публикует посты и является админом каналов.
# TELEGRAM_BOT_TOKEN уже выше; здесь только id админа для уведомлений/модерации.
# Узнать: написать боту /start и посмотреть getUpdates → message.chat.id.
TELEGRAM_ADMIN_CHAT_ID=
# 1 = без ссылок в постах Mastodon (антиспам нового аккаунта)
MASTODON_NO_LINKS=0

# Fediverse (Mastodon-совместимые: Pleroma/Akkoma/GoToSocial/Friendica)
PLEROMA_BASE_URL=
PLEROMA_TOKEN=
AKKOMA_BASE_URL=
AKKOMA_TOKEN=
GOTOSOCIAL_BASE_URL=
GOTOSOCIAL_TOKEN=
FRIENDICA_BASE_URL=
FRIENDICA_TOKEN=
# Misskey / Firefish / Sharkey (host без https://)
MISSKEY_HOST=
MISSKEY_TOKEN=
MISSKEY_MAX_CHARS=3000
