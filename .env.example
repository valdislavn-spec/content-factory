# =====================================================================
#  Секреты контент-завода. Скопируйте файл в .env и заполните.
#  .env не попадает в git (см. .gitignore).
# =====================================================================

# --- Публикация в Telegram (бесплатный Bot API) -----------------------
# 1) Создайте бота у @BotFather: /newbot
# 2) Добавьте бота администратором в каждый канал (право "Публикация")
TELEGRAM_BOT_TOKEN=

# Релей Bot API (если api.telegram.org блокируется сетью), см. docs/pipedream-relay.md
# TELEGRAM_API_BASE=https://eoxxxxx.m.pipedream.net
TELEGRAM_API_BASE=

# ID каналов: @username или числовой -100... (по одному на канал).
# Если не заполнить — канал работает в dry_run (посты в data/outbox).
TELEGRAM_CHAT_ID_TECH_AI=
TELEGRAM_CHAT_ID_BUSINESS_FINANCE=
TELEGRAM_CHAT_ID_SCIENCE_HEALTH=
TELEGRAM_CHAT_ID_AUTO=
TELEGRAM_CHAT_ID_TRAVEL=
TELEGRAM_CHAT_ID_CULTURE=
# Испаноязычные каналы (config/channels.es.yaml)
TELEGRAM_CHAT_ID_TECH_AI_ES=
TELEGRAM_CHAT_ID_CRYPTO_ES=
TELEGRAM_CHAT_ID_FUTBOL_ES=

# --- Публикация во ВКонтакте (бесплатно, работает в России) ----------
# Токен группы с правами wall, manage. group_id — числовой id группы.
VK_ACCESS_TOKEN=
VK_GROUP_ID=

# --- Язык и список каналов -------------------------------------------
# Язык задаётся у канала в config/channels*.yaml (language: ru|en|es),
# а файл каналов — в app.channels_file (config/settings.yaml).
# Можно переопределить файлом каналов без правки YAML:
# CONTENT_FACTORY_CHANNELS=config/channels.en.yaml
# Испаноязычные каналы (ЛатАм/Испания):
# CONTENT_FACTORY_CHANNELS=config/channels.es.yaml

# --- Режим публикации ------------------------------------------------
# true  — ничего не публиковать, складывать посты в data/outbox (безопасно)
# false — реальная публикация
CONTENT_FACTORY_DRY_RUN=true

# --- Опционально: локальная LLM через Ollama -------------------------
# Установите Ollama (бесплатно, работает офлайн), затем:
#   ollama pull qwen2.5:7b
# В config/settings.yaml укажите llm.provider: ollama
# OLLAMA_HOST при необходимости: http://127.0.0.1:11434
OLLAMA_HOST=

# --- Опционально: GigaChat (Сбер) — есть бесплатный лимит ------------
# credentials — base64(client_id:client_secret) из личного кабинета GigaChat API
GIGACHAT_CREDENTIALS=

# --- Опционально: YandexGPT (пробный грант) --------------------------
YANDEXGPT_API_KEY=
YANDEX_FOLDER_ID=

# --- LLM-провайдеры (бесплатные лимиты) ------------------------------
# Добавляются скриптом: python3 scripts/set_extra_keys.py
# Из РФ: OpenAI (403 unsupported_country), Groq и OpenRouter (403 Cloudflare
# security policy) недоступны — нужен зарубежный egress (VPN, GitHub Actions).
# SambaNova из РФ доступен, но free-аккаунту нужен payment method (402).
# HuggingFace free-аккаунту нужны кредиты инференса (402).
GROQ_API_KEY=
OPENROUTER_API_KEY=
SAMBANOVA_API_KEY=
HUGGINGFACE_API_KEY=
OPENAI_API_KEY=
# Новостные API / поиск (опционально, добавляются тем же скриптом)
# newsdata.io — работает из РФ; GDELT Cloud (gdeltcloud.com) — работает,
# free = 200 стартовых вызовов; Tavily — из РФ 403 (геоблок).
NEWSDATA_API_KEY=
CURRENTS_API_KEY=
APITUBE_API_KEY=
TRENDS_API_KEY=
GDELT_CLOUD_API_KEY=
TAVILY_API_KEY=
TAVILY_API_KEY_2=

# --- Опционально: Dify Cloud — приложение как LLM ---------------------
# 1) https://cloud.dify.ai → создайте приложение (Chat или Text Generator)
# 2) в приложении: API Access → API Key (ключ именно приложения, не workspace)
# 3) config/settings.yaml: llm.provider: dify и llm.dify.app_mode
DIFY_API_KEY=
# Для self-hosted Dify: адрес API, например http://127.0.0.1/v1
DIFY_BASE_URL=

# --- Опционально: отдельные Dify-приложения (workflow) ----------------
# Новости/агрегатор, поиск трендов и SEO-оптимизация постов.
# Готовые посты (Six-Channel...): DIFY_POSTS_API_KEY — основной для публикации.
# Ключи добавляются скриптом: python3 scripts/set_dify_app_keys.py
DIFY_POSTS_API_KEY=
DIFY_NEWS_API_KEY=
DIFY_TRENDS_API_KEY=
DIFY_SEO_API_KEY=

# --- Опционально: World News API (бесплатно 50 points/сутки) ---------
# Ключ: https://worldnewsapi.com/console → API key.
# Добавляется скриптом: python3 scripts/set_worldnews_key.py
WORLD_NEWS_API_KEY=

# --- Опционально: Telegram-каналы как ИСТОЧНИКИ (Telethon) -----------
# api_id/api_hash: https://my.telegram.org (бесплатно)
TG_API_ID=
TG_API_HASH=
# Имя файла сессии (создастся при первом запуске, храните как пароль)
TG_SESSION=content_factory

# --- Cloudflare Workers AI (OpenAI-совместимый API) -------------------
# Account ID: дашборд Cloudflare → страница аккаунта (правая панель).
# Токен: My Profile → API Tokens → Create Token, права Account → Workers AI → Read.
# Подключён как provider: cloudflare в config/settings.yaml.
# Free-план: ~10 000 neurons/день.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
