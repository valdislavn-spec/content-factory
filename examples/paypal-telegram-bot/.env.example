# Telegram
TELEGRAM_BOT_TOKEN=123456:replace_me

# PayPal REST app (developer.paypal.com → Apps & Credentials)
# Для теста: sandbox. Для прода: https://api-m.paypal.com
PAYPAL_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=replace_me
PAYPAL_CLIENT_SECRET=replace_me

# Публичный HTTPS-адрес этого сервиса (Cloudflare Tunnel / ngrok / VPS)
PUBLIC_BASE_URL=https://your-domain.example
WEB_PORT=8080

# Товар
PRODUCT_NAME=Доступ к закрытому каналу
PRICE=9.99
CURRENCY=USD

# Webhook ID из PayPal → Apps & Credentials → Webhooks
PAYPAL_WEBHOOK_ID=
