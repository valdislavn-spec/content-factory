{
  "providers": {
    "dify": {
      "type": "dify",
      "base_url": "https://api.dify.ai/v1",
      "api_key_env": "DIFY_API_KEY",
      "app_mode": "chat",
      "user": "mcp-content-factory",
      "timeout": 180
    }
  },
  "routes": {
    "classifier": {
      "chain": [
        {
          "provider": "dify",
          "model": "dify-classifier"
        }
      ],
      "temperature": 0.0,
      "max_tokens": 220,
      "json": true
    },
    "researcher": {
      "chain": [
        {
          "provider": "dify",
          "model": "dify-researcher"
        }
      ],
      "temperature": 0.2,
      "max_tokens": 900,
      "json": true
    },
    "writer": {
      "chain": [
        {
          "provider": "dify",
          "model": "dify-writer"
        }
      ],
      "temperature": 0.5,
      "max_tokens": 1200,
      "json": false
    },
    "critic": {
      "chain": [
        {
          "provider": "dify",
          "model": "dify-critic"
        }
      ],
      "temperature": 0.0,
      "max_tokens": 500,
      "json": true
    },
    "editor": {
      "chain": [
        {
          "provider": "dify",
          "model": "dify-editor"
        }
      ],
      "temperature": 0.4,
      "max_tokens": 1200,
      "json": false
    }
  },
  "mcp": {
    "servers": {
      "content_tools": {
        "builtin": true
      }
    }
  },
  "feeds": [
    "https://news.google.com/rss/search?q=%D0%98%D0%98+OR+MCP&hl=ru&gl=RU&ceid=RU:ru",
    "https://habr.com/ru/rss/news/?fl=ru"
  ],
  "pipeline": {
    "channel": "tech-ai",
    "max_articles": 8,
    "min_articles": 2,
    "allow_publish": false,
    "hashtags": [
      "#ИИ",
      "#MCP",
      "#контент"
    ]
  },
  "budget": {
    "max_tokens": 0
  }
}
