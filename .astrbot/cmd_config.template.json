{
  "platform": [
    {
      "id": "telegram",
      "type": "telegram",
      "enable": true,
      "telegram_token": "__TELEGRAM_BOT_TOKEN__",
      "start_message": "Привет! Я AI-ассистент контент-фабрики. Задай вопрос или пришли ссылку/текст.",
      "telegram_api_base_url": "https://api.telegram.org/bot",
      "telegram_file_base_url": "https://api.telegram.org/file/bot",
      "telegram_command_register": true,
      "telegram_command_auto_refresh": true,
      "telegram_command_register_interval": 300,
      "telegram_polling_restart_delay": 5.0
    }
  ],
  "provider_sources": [
    {
      "id": "groq",
      "type": "openai_chat_completion",
      "provider_type": "chat_completion",
      "api_base": "https://api.groq.com/openai/v1",
      "key": [
        "__GROQ_API_KEY__"
      ],
      "timeout": 120,
      "proxy": "",
      "custom_headers": {}
    },
    {
      "id": "openrouter",
      "type": "openai_chat_completion",
      "provider_type": "chat_completion",
      "api_base": "https://openrouter.ai/api/v1",
      "key": [
        "__OPENROUTER_API_KEY__"
      ],
      "timeout": 120,
      "proxy": "",
      "custom_headers": {}
    },
    {
      "id": "deepseek",
      "type": "openai_chat_completion",
      "provider_type": "chat_completion",
      "api_base": "https://api.deepseek.com/v1",
      "key": [
        "__DEEPSEEK_API_KEY__"
      ],
      "timeout": 120,
      "proxy": "",
      "custom_headers": {}
    }
  ],
  "provider": [
    {
      "id": "groq-oss",
      "provider_source_id": "groq",
      "model": "openai/gpt-oss-120b",
      "enable": true
    },
    {
      "id": "openrouter-free",
      "provider_source_id": "openrouter",
      "model": "openrouter/free",
      "enable": true
    },
    {
      "id": "deepseek-flash",
      "provider_source_id": "deepseek",
      "model": "deepseek-flash",
      "enable": true
    },
    {
      "id": "cf-embed",
      "type": "openai_embedding",
      "provider": "cloudflare",
      "provider_type": "embedding",
      "enable": true,
      "embedding_api_key": "__CLOUDFLARE_API_TOKEN__",
      "embedding_api_base": "https://api.cloudflare.com/client/v4/accounts/__CLOUDFLARE_ACCOUNT_ID__/ai/v1",
      "embedding_model": "@cf/baai/bge-m3",
      "embedding_dimensions": 1024,
      "embedding_dimensions_mode": "never",
      "timeout": 30,
      "proxy": ""
    }
  ],
  "provider_settings": {
    "enable": true,
    "provider_pool": [
      "*"
    ],
    "streaming_response": false,
    "datetime_system_prompt": true,
    "persona_pool": [
      "*"
    ],
    "default_provider_id": "groq-oss",
    "prompt_prefix": "IMPORTANT: Always reply in the language of the user's last message. Default language is Russian. If the user writes in English, reply in English; if the user writes in Spanish, reply in Spanish. If the user explicitly asks to switch language (e.g. '/ru', 'по-русски', '/en', 'in English', '/es', 'en español'), switch to that language for the rest of the conversation. Never switch language without a request.\n\n{{prompt}}"
  },
  "dashboard": {
    "enable": true,
    "host": "0.0.0.0",
    "port": 6185
  },
  "timezone": "UTC",
  "kb_names": [
    "content-factory"
  ],
  "kb_fusion_top_k": 20,
  "kb_final_top_k": 5
}
