{
  "platform": [
    {
      "id": "telegram",
      "type": "telegram",
      "enable": true,
      "telegram_token": "__TELEGRAM_BOT_TOKEN__",
      "start_message": "Привет! Я AI-ассистент контент-фабрики. Задай вопрос или пришли ссылку/текст.",
      "telegram_api_base_url": "https://api.telegram.org/bot",
      "telegram_file_base_url": "https://api.telegram.org/file/bot",
      "telegram_command_register": true,
      "telegram_command_auto_refresh": true,
      "telegram_command_register_interval": 300,
      "telegram_polling_restart_delay": 5.0
    }
  ],
  "provider_sources": [
    {
      "id": "groq",
      "type": "openai_chat_completion",
      "provider_type": "chat_completion",
      "api_base": "https://api.groq.com/openai/v1",
      "key": [
        "__GROQ_API_KEY__"
      ],
      "timeout": 120,
      "proxy": "",
      "custom_headers": {}
    },
    {
      "id": "openrouter",
      "type": "openai_chat_completion",
      "provider_type": "chat_completion",
      "api_base": "https://openrouter.ai/api/v1",
      "key": [
        "__OPENROUTER_API_KEY__"
      ],
      "timeout": 120,
      "proxy": "",
      "custom_headers": {}
    },
    {
      "id": "deepseek",
      "type": "openai_chat_completion",
      "provider_type": "chat_completion",
      "api_base": "https://api.deepseek.com/v1",
      "key": [
        "__DEEPSEEK_API_KEY__"
      ],
      "timeout": 120,
      "proxy": "",
      "custom_headers": {}
    }
  ],
  "provider": [
    {
      "id": "groq-oss",
      "provider_source_id": "groq",
      "model": "openai/gpt-oss-120b",
      "enable": true
    },
    {
      "id": "openrouter-free",
      "provider_source_id": "openrouter",
      "model": "openrouter/free",
      "enable": true
    },
    {
      "id": "deepseek-flash",
      "provider_source_id": "deepseek",
      "model": "deepseek-flash",
      "enable": true
    },
    {
      "id": "cf-embed",
      "type": "openai_embedding",
      "provider": "cloudflare",
      "provider_type": "embedding",
      "enable": true,
      "embedding_api_key": "__CLOUDFLARE_API_TOKEN__",
      "embedding_api_base": "https://api.cloudflare.com/client/v4/accounts/__CLOUDFLARE_ACCOUNT_ID__/ai/v1",
      "embedding_model": "@cf/baai/bge-m3",
      "embedding_dimensions": 1024,
      "embedding_dimensions_mode": "never",
      "timeout": 30,
      "proxy": ""
    }
  ],
  "provider_settings": {
    "enable": true,
    "provider_pool": [
      "*"
    ],
    "streaming_response": false,
    "datetime_system_prompt": true,
    "persona_pool": [
      "*"
    ],
    "default_provider_id": "groq-oss",
    "prompt_prefix": "{{prompt}}"
  },
  "dashboard": {
    "enable": true,
    "host": "0.0.0.0",
    "port": 6185
  },
  "timezone": "UTC",
  "kb_names": [
    "content-factory"
  ],
  "kb_fusion_top_k": 30,
  "kb_final_top_k": 8,
  "agent_runner": {
    "runner_type": "local",
    "config": {
      "model": {
        "provider_id": "groq-oss",
        "fallback_provider_ids": [
          "openrouter-free",
          "deepseek-flash"
        ],
        "request_max_retries": 5
      },
      "persona": {
        "persona_id": "default",
        "safety_mode": true,
        "safety_mode_strategy": "system_prompt"
      },
      "compression": {
        "max_turns": -1,
        "trim_turns": 1,
        "overflow_strategy": "llm_compress",
        "instruction": "",
        "keep_recent_ratio": 0.15,
        "provider_id": "",
        "fallback_max_tokens": 128000
      },
      "misc": {
        "max_steps": 128,
        "tool_schema_mode": "full",
        "tool_call_timeout": 120,
        "sanitize_context_by_modalities": false
      }
    }
  }
}
